index 00000000..4d7bdff5
--- /dev/null
+++ b/scripts/whatsapp-bridge/inbound_message_gate.test.mjs
@@ -0,0 +1,101 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, readFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+
+import { classifyOwnerMessageGate } from './owner_message_gate.js';
+import { classifyUpsertType, createProcessedMessageLedger } from './inbound_message_gate.js';
+
+function withLedger(run) {
+  const directory = mkdtempSync(path.join(tmpdir(), 'hermes-inbound-ledger-'));
+  const filePath = path.join(directory, 'processed-inbound-ids.jsonl');
+  try {
+    return run({
+      filePath,
+      ledger: createProcessedMessageLedger({ filePath, maxEntries: 8, compactEvery: 2 }),
+    });
+  } finally {
+    rmSync(directory, { recursive: true, force: true });
+  }
+}
+
+const NEW_OWNER_MESSAGE = {
+  chatId: '628111111111@s.whatsapp.net',
+  fromMe: false,
+  messageId: 'NEW-MESSAGE-1',
+};
+
+test('new notify event is accepted and recorded without storing raw identifiers', () => {
+  withLedger(({ filePath, ledger }) => {
+    assert.deepEqual(classifyUpsertType({ type: 'notify', mode: 'bot' }), { action: 'accept' });
+    assert.deepEqual(ledger.rememberIfNew(NEW_OWNER_MESSAGE), { action: 'accept', tracked: true });
+
+    const persisted = readFileSync(filePath, 'utf8');
+    assert.match(persisted, /^[a-f0-9]{64}\n$/);
+    assert.equal(persisted.includes(NEW_OWNER_MESSAGE.chatId), false);
+    assert.equal(persisted.includes(NEW_OWNER_MESSAGE.messageId), false);
+  });
+});
+
+test('history append is dropped in separate-bot mode but remains valid for self-chat mode', () => {
+  assert.deepEqual(
+    classifyUpsertType({ type: 'append', mode: 'bot' }),
+    { action: 'drop', reason: 'history_append' },
+  );
+  assert.deepEqual(classifyUpsertType({ type: 'append', mode: 'self-chat' }), { action: 'accept' });
+});
+
+test('own message is rejected by the existing bot-mode owner gate', () => {
+  const event = { ...NEW_OWNER_MESSAGE, fromMe: true, messageId: 'OWN-MESSAGE-1' };
+  const decision = classifyOwnerMessageGate({
+    fromMe: event.fromMe,
+    fromOwnerEnabled: false,
+    recentlySent: { has: () => false },
+    allowlistMatches: () => true,
+    messageId: event.messageId,
+    chatId: event.chatId,
+  });
+  assert.deepEqual(decision, { action: 'drop_disabled' });
+});
+
+test('duplicate event in one process is dropped', () => {
+  withLedger(({ ledger }) => {
+    assert.equal(ledger.rememberIfNew(NEW_OWNER_MESSAGE).action, 'accept');
+    assert.deepEqual(
+      ledger.rememberIfNew(NEW_OWNER_MESSAGE),
+      { action: 'drop', reason: 'duplicate_inbound_id', tracked: true },
+    );
+  });
+});
+
+test('duplicate remains dropped after a simulated bridge restart', () => {
+  withLedger(({ filePath, ledger }) => {
+    assert.equal(ledger.rememberIfNew(NEW_OWNER_MESSAGE).action, 'accept');
+    const restartedLedger = createProcessedMessageLedger({ filePath, maxEntries: 8, compactEvery: 2 });
+    assert.deepEqual(
+      restartedLedger.rememberIfNew(NEW_OWNER_MESSAGE),
+      { action: 'drop', reason: 'duplicate_inbound_id', tracked: true },
+    );
+  });
+});
+
+test('ledger stays bounded and remains correct after compaction and restart', () => {
+  withLedger(({ filePath, ledger }) => {
+    for (let index = 0; index < 12; index += 1) {
+      assert.equal(ledger.rememberIfNew({ ...NEW_OWNER_MESSAGE, messageId: `message-${index}` }).action, 'accept');
+    }
+    assert.equal(ledger.size(), 8);
+
+    const restartedLedger = createProcessedMessageLedger({ filePath, maxEntries: 8, compactEvery: 2 });
+    assert.equal(restartedLedger.size(), 8);
+    assert.equal(
+      restartedLedger.rememberIfNew({ ...NEW_OWNER_MESSAGE, messageId: 'message-11' }).action,
+      'drop',
+    );
+    assert.equal(
+      restartedLedger.rememberIfNew({ ...NEW_OWNER_MESSAGE, messageId: 'message-0' }).action,
+      'accept',
+    );
+  });
+});
