diff --git a/scripts/whatsapp-bridge/inbound_message_gate.js b/scripts/whatsapp-bridge/inbound_message_gate.js
new file mode 100644
index 00000000..acd4b5e3
--- /dev/null
+++ b/scripts/whatsapp-bridge/inbound_message_gate.js
@@ -0,0 +1,98 @@
+import { appendFileSync, existsSync, readFileSync, renameSync, writeFileSync } from 'fs';
+import { createHash } from 'crypto';
+
+const HASH_PATTERN = /^[a-f0-9]{64}$/;
+
+export function classifyUpsertType({ type, mode }) {
+  if (type !== 'notify' && type !== 'append') {
+    return { action: 'drop', reason: 'unsupported_upsert_type' };
+  }
+  if (type === 'append' && mode === 'bot') {
+    return { action: 'drop', reason: 'history_append' };
+  }
+  return { action: 'accept' };
+}
+
+export function inboundMessageFingerprint({ chatId, fromMe, messageId }) {
+  if (!chatId || !messageId) return '';
+  return createHash('sha256')
+    .update(`${String(chatId)}\0${fromMe ? '1' : '0'}\0${String(messageId)}`)
+    .digest('hex');
+}
+
+export function createProcessedMessageLedger({
+  filePath,
+  maxEntries = 4096,
+  compactEvery = 256,
+  onError = () => {},
+}) {
+  if (!filePath) throw new TypeError('filePath is required');
+  if (!Number.isInteger(maxEntries) || maxEntries < 1) {
+    throw new RangeError('maxEntries must be a positive integer');
+  }
+
+  const fingerprints = new Set();
+  let prunedSinceCompact = 0;
+
+  function report(error) {
+    try { onError(error); } catch {}
+  }
+
+  function trim() {
+    while (fingerprints.size > maxEntries) {
+      fingerprints.delete(fingerprints.values().next().value);
+      prunedSinceCompact += 1;
+    }
+  }
+
+  function compact() {
+    const temporaryPath = `${filePath}.tmp`;
+    try {
+      const body = fingerprints.size > 0
+        ? `${Array.from(fingerprints).join('\n')}\n`
+        : '';
+      writeFileSync(temporaryPath, body, { encoding: 'utf8', mode: 0o600 });
+      renameSync(temporaryPath, filePath);
+      prunedSinceCompact = 0;
+    } catch (error) {
+      report(error);
+    }
+  }
+
+  if (existsSync(filePath)) {
+    try {
+      for (const line of readFileSync(filePath, 'utf8').split(/\r?\n/)) {
+        const fingerprint = line.trim().toLowerCase();
+        if (!HASH_PATTERN.test(fingerprint)) continue;
+        if (fingerprints.has(fingerprint)) fingerprints.delete(fingerprint);
+        fingerprints.add(fingerprint);
+      }
+      trim();
+    } catch (error) {
+      report(error);
+    }
+  }
+
+  return {
+    rememberIfNew(messageKey) {
+      const fingerprint = inboundMessageFingerprint(messageKey);
+      if (!fingerprint) return { action: 'accept', tracked: false };
+      if (fingerprints.has(fingerprint)) {
+        return { action: 'drop', reason: 'duplicate_inbound_id', tracked: true };
+      }
+
+      fingerprints.add(fingerprint);
+      try {
+        appendFileSync(filePath, `${fingerprint}\n`, { encoding: 'utf8', mode: 0o600 });
+      } catch (error) {
+        report(error);
+      }
+      trim();
+      if (prunedSinceCompact >= compactEvery) compact();
+      return { action: 'accept', tracked: true };
+    },
+    size() {
+      return fingerprints.size;
+    },
+  };
+}
